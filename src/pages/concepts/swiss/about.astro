---
import { Image } from 'astro:assets';
import Layout from '../../../concepts/swiss/Layout.astro';
import Section from '../../../concepts/swiss/Section.astro';
import PageHead from '../../../concepts/swiss/PageHead.astro';
import Closing from '../../../concepts/swiss/Closing.astro';
import { sentence } from '../../../concepts/swiss/text';
import { coaches, principles, reasons } from '../../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const certified = reasons.find((r) => r.title.startsWith('Certified'))!;
const lists = (coach: (typeof coaches)[number]) =>
  [
    { title: 'Career highs', items: coach.careerHighs },
    { title: 'Career lows', items: coach.careerLows },
  ].filter((list) => list.items.length > 0);
---
<Layout page="about" title="About: Trilogy Training">
  <PageHead label="About" note="Two coaches">
    Coaching built on consistency, communication and trust.
  </PageHead>

  <Section num="01" label="Coaches" class="sw-section--coaches">
    <p class="sw-lede sw-intro">{certified.desc}</p>
  </Section>

  {coaches.map((coach) => (
    <article class="sw-coach">
      <div class="sw-wrap">
        <div class="sw-grid sw-coach__grid">
          <figure class="sw-coach__figure">
            <Image
              class="sw-photo sw-photo--coach"
              src={coach.photo}
              alt={`${coach.name} racing`}
              widths={[320, 480, 560]}
              sizes="(min-width: 901px) 330px, (min-width: 600px) 420px, 92vw"
            />
          </figure>
          <div class="sw-coach__body">
            <p class="sw-label sw-coach__base">Based in {coach.base}</p>
            <h3 class="sw-coach__name">{coach.name}</h3>
            <p class="sw-coach__bio">{coach.bio}</p>
            {lists(coach).map((list, i, all) => (
              <div class:list={['sw-coach__list', all.length > 1 && `sw-coach__list--${i + 1}`]}>
                <h4 class="sw-label">{list.title}</h4>
                <ul class="sw-ruled">
                  {list.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </article>
  ))}

  <Section num="02" label="Principles">
    <ol class="sw-principles">
      {principles.map((principle, i) => (
        <li class="sw-principle">
          <p class="sw-label sw-principle__num" aria-hidden="true">{pad(i + 1)}</p>
          <h3 class="sw-principle__title">{sentence(principle.title)}</h3>
          <p class="sw-principle__desc">{principle.desc}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Closing num="03" />
</Layout>
