---
import Layout from '../../../concepts/podium/Layout.astro';
import Cta from '../../../concepts/podium/Cta.astro';
import { conceptUrl } from '../../../concepts/directions';
import { currencies, defaultCurrency, faqs, plans, premade, trainingPeaksUrl } from '../../../data/site';

---
<Layout page="plans" title="Plans and pricing: Trilogy Training">
  <div data-pricing>
    <section class="pd-pagehead">
      <div class="pd-wrap pd-pagehead__inner">
        <div>
          <p class="pd-label pd-label--accent">Plans</p>
          <h1 class="pd-h1">Plans <em>&amp; pricing.</em></h1>
        </div>
        <div class="pd-currency" role="group" aria-label="Currency">
          <p class="pd-label" aria-hidden="true">Currency</p>
          <div class="pd-currency__options">
            {currencies.map((c) => (
              <button type="button" class="pd-currency__btn" data-currency={c} aria-pressed={c === defaultCurrency ? 'true' : 'false'}>
                {c}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="pd-plans-section" aria-label="Coaching plans">
      <div class="pd-wrap">
        <ul class="pd-plans">
          {plans.map((plan) => (
            <li class="pd-plan">
              <h2 class="pd-plan__name">{plan.name}</h2>
              <p class="pd-plan__desc">{plan.desc}</p>
              <p class="pd-plan__price">
                {plan.prices ? (
                  <>
                    <span class="pd-plan__figure">
                      <span class="pd-plan__amount" data-prices={JSON.stringify(plan.prices)}>{plan.prices[defaultCurrency]}</span>
                      <span class="pd-plan__code" data-currency-label>{defaultCurrency}</span>
                    </span>
                    <span class="pd-label">per month</span>
                  </>
                ) : (
                  <>
                    <span class="pd-plan__figure pd-plan__figure--text">On request</span>
                    <span class="pd-label">Priced to fit</span>
                  </>
                )}
              </p>
              <a class:list={['pd-btn', 'pd-btn--block', { 'pd-btn--ghost': !plan.prices }]} href={conceptUrl('podium', 'contact')}>
                {plan.prices ? 'Book a free call' : 'Get in touch'}
                <span class="pd-visually-hidden"> about {plan.name} coaching</span>
                <span class="pd-arrow" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <section class="pd-section pd-section--tight" aria-labelledby="pd-premade-title">
    <div class="pd-wrap">
      <div class="pd-premade">
        <div>
          <p class="pd-label pd-label--accent">{premade.label}</p>
          <h2 class="pd-h2" id="pd-premade-title">{premade.title}</h2>
        </div>
        <div class="pd-premade__side">
          <p>{premade.desc}</p>
          <a class="pd-btn pd-btn--ghost" href={trainingPeaksUrl} rel="noopener">
            {premade.cta}
            <span class="pd-arrow pd-arrow--out" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pd-section pd-section--surface" aria-labelledby="pd-faq-title">
    <div class="pd-wrap pd-faq-layout">
      <header class="pd-head">
        <p class="pd-label pd-label--accent">FAQ</p>
        <h2 class="pd-h2" id="pd-faq-title">Good <em>questions.</em></h2>
      </header>
      <div class="pd-faqs">
        {faqs.map((faq) => (
          <details class="pd-faq" name="faq">
            <summary class="pd-faq__q">
              <span>{faq.question}</span>
              <span class="pd-faq__plus" aria-hidden="true"></span>
            </summary>
            <p class="pd-faq__a">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Layout>

<script>
  import { initCurrencySwitch } from '../../../scripts/currency';
  document.querySelectorAll<HTMLElement>('[data-pricing]').forEach(initCurrencySwitch);
</script>
