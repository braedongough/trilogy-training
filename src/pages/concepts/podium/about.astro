---
import { Image } from 'astro:assets';
import Layout from '../../../concepts/podium/Layout.astro';
import Cta from '../../../concepts/podium/Cta.astro';
import NumList from '../../../concepts/podium/NumList.astro';
import { coaches, principles, reasons, testimonials } from '../../../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const photoAlt: Record<string, string> = {
  adam: 'Adam Labbett running along a cobbled street during a race',
  cameron: 'Cameron Keast running in a red and white race suit during a triathlon',
};
const certified = reasons.find((r) => r.title.includes('Certified'))!;
---
<Layout page="about" title="About the coaches: Trilogy Training">
  <section class="pd-pagehead">
    <div class="pd-wrap pd-pagehead__inner">
      <div>
        <p class="pd-label pd-label--accent">About</p>
        <h1 class="pd-h1">Meet <em>the coaches.</em></h1>
      </div>
      <p class="pd-pagehead__lede">{certified.desc}</p>
    </div>
  </section>

  {coaches.map((coach, i) => {
    const first = coach.name.split(' ')[0];
    const results = testimonials.filter((t) => t.coach === first);
    const lists = [
      { label: 'Career highs', items: coach.careerHighs },
      { label: 'Career lows', items: coach.careerLows },
    ].filter((list) => list.items.length > 0);
    return (
      <section class:list={['pd-coach', { 'pd-coach--flip': i % 2 === 1 }]} aria-labelledby={`pd-coach-${coach.id}`}>
        <div class="pd-wrap pd-coach__inner">
          <figure class="pd-coach__photo">
            <Image
              src={coach.photo}
              alt={photoAlt[coach.id] ?? coach.name}
              widths={[320, 480, 562]}
              sizes="(min-width: 1320px) 500px, (min-width: 900px) 38vw, 90vw"
            />
          </figure>
          <div class="pd-coach__body">
            <p class="pd-label pd-label--accent">Coach {pad(i + 1)} / {coach.base}</p>
            <h2 class="pd-coach__name" id={`pd-coach-${coach.id}`}>{coach.name}</h2>
            <p class="pd-coach__bio">{coach.bio}</p>

            {lists.length > 0 && (
              <div class="pd-coach__lists">
                {lists.map((list) => (
                  <div class="pd-career">
                    <h3 class="pd-label">{list.label}</h3>
                    <ul class="pd-career__list">
                      {list.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            {results.length > 0 && (
              <div class="pd-career pd-career--results">
                <h3 class="pd-label">Athletes coached by {first}</h3>
                <ul class="pd-career__list pd-career__list--results">
                  {results.map((t) => (
                    <li>
                      <span>{t.event}</span>
                      <span class="pd-label">{t.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })}

  <section class="pd-section" aria-labelledby="pd-principles-title">
    <div class="pd-wrap">
      <header class="pd-head">
        <p class="pd-label pd-label--accent">Principles</p>
        <h2 class="pd-h2" id="pd-principles-title">How we <em>coach.</em></h2>
      </header>
      <NumList items={principles} />
    </div>
  </section>

  <Cta />
</Layout>
