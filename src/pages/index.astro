---
import { Image } from 'astro:assets';
import Layout from '../concepts/podium/Layout.astro';
import Cta from '../concepts/podium/Cta.astro';
import PointList from '../concepts/podium/PointList.astro';
import Silhouettes from '../concepts/podium/Silhouettes.astro';
import Splatter from '../concepts/podium/Splatter.astro';
import { conceptUrl } from '../concepts/directions';
import { coaches, hero, reasons, steps, testimonials } from '../data/site';

const [feature, ...others] = testimonials;
const photoAlt: Record<string, string> = {
  adam: 'Adam Labbett running along a cobbled street during a race',
  cameron: 'Cameron Keast running in a red and white race suit during a triathlon',
};
---
<Layout
  page="home"
  title="Trilogy Training | Personalised Endurance Coaching for Triathletes & Runners"
  description="Personalised triathlon, running, swimming & cycling coaching from certified endurance coaches. Book your free consultation today."
  canonicalPath="/"
  ogTitle="Trilogy Training | Personalised Endurance Coaching"
  ogDescription="Train smarter with personalised coaching from experienced endurance sport coaches."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "Trilogy Training",
          "url": "https://trilogy-training.com",
          "logo": "https://trilogy-training.com/favicon.svg",
          "sameAs": [
            "https://www.instagram.com/trilogy_training_/",
            "https://www.facebook.com/trilogy.tri.training/"
          ],
          "description": "Personalised endurance coaching for triathletes, runners, swimmers, and cyclists."
        },
        {
          "@type": "SportsActivityLocation",
          "name": "Trilogy Training",
          "url": "https://trilogy-training.com",
          "description": "Personalised endurance coaching for triathletes, runners, swimmers, and cyclists."
        },
        {
          "@type": "Service",
          "serviceType": "Endurance Coaching",
          "provider": { "@type": "Organization", "name": "Trilogy Training" },
          "description": "Personalised triathlon, running, swimming, and cycling coaching plans with certified coaches.",
          "offers": [
            { "@type": "Offer", "name": "Single Discipline", "description": "Ongoing coaching, feedback, and structured training for one sport", "price": "100", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Multi-Discipline", "description": "Full coaching across multiple disciplines", "price": "200", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Custom", "description": "A coaching arrangement built around your specific needs" }
          ]
        },
        {
          "@type": "Person",
          "name": "Adam Labbett",
          "jobTitle": "Endurance Coach",
          "worksFor": { "@type": "Organization", "name": "Trilogy Training" }
        },
        {
          "@type": "Person",
          "name": "Cameron Keast",
          "jobTitle": "Endurance Coach",
          "worksFor": { "@type": "Organization", "name": "Trilogy Training" }
        }
      ]
    })} />
  </Fragment>
  <section class="pd-hero">
    <Silhouettes />
    <div class="pd-wrap pd-hero__inner">
      <div class="pd-hero__copy">
        <h1 class="pd-hero__title">
          {hero.titleLines.map((line) => <span>{line}</span>)}
        </h1>
        <p class="pd-hero__sub">{hero.subtitle}</p>
        <div class="pd-hero__actions">
          <a class="pd-btn" href={conceptUrl('podium', 'contact')}>
            {hero.primaryCta}
            <span class="pd-arrow" aria-hidden="true"></span>
          </a>
          <a class="pd-btn pd-btn--ghost" href={conceptUrl('podium', 'plans')}>{hero.secondaryCta}</a>
        </div>
      </div>
      <div class="pd-hero__coaches">
        <Splatter />
        <span class="pd-tri pd-hero__tri pd-hero__tri--1" aria-hidden="true"></span>
        <span class="pd-tri pd-hero__tri pd-hero__tri--2" aria-hidden="true"></span>
        {coaches.map((coach) => (
          <figure class="pd-hero__coach">
            <Image
              src={coach.photo}
              alt={photoAlt[coach.id] ?? coach.name}
              widths={[180, 270, 360, 480]}
              sizes="(min-width: 960px) 12vw, 180px"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>
              <span class="pd-hero__coach-name">{coach.name}</span>
              <span class="pd-label">Coach / {coach.base}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="pd-results" aria-labelledby="pd-results-title">
    <div class="pd-wrap">
      <div class="pd-results__head">
        <h2 class="pd-label pd-label--accent" id="pd-results-title">Athlete results</h2>
        <p class="pd-label">Athlete / Coach</p>
      </div>
      <ul class="pd-results__list">
        {testimonials.map((t) => (
          <li class="pd-results__row">
            <span class="pd-results__event">{t.event}</span>
            <span class="pd-results__who">
              <span class="pd-results__name">{t.name}</span>
              <span class="pd-label">Coached by {t.coach}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pd-section" aria-labelledby="pd-how-title">
    <div class="pd-wrap">
      <header class="pd-head">
        <p class="pd-label pd-label--accent">How it works</p>
        <h2 class="pd-h2" id="pd-how-title">Three steps <em>to the start line.</em></h2>
      </header>
      <ol class="pd-steps">
        {steps.map((step) => (
          <li class="pd-step">
            <span class="pd-step__num" aria-hidden="true">{step.num}</span>
            <h3 class="pd-h3">{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="pd-section pd-section--surface" aria-labelledby="pd-proof-title">
    <div class="pd-wrap">
      <header class="pd-head">
        <p class="pd-label pd-label--accent">In their words</p>
        <h2 class="pd-h2" id="pd-proof-title">Goals set. <em>Goals met.</em></h2>
      </header>

      <article class="pd-feature">
        <div class="pd-feature__lead">
          <p class="pd-label">Coached by {feature.coach}</p>
          <h3 class="pd-feature__event">{feature.event}</h3>
          <p class="pd-quote__name">{feature.name}</p>
        </div>
        <blockquote class="pd-feature__quote">
          <p>{feature.quote}</p>
        </blockquote>
      </article>

      <div class="pd-quotes">
        {others.map((t) => (
          <article class="pd-quote">
            <h3 class="pd-quote__event">{t.event}</h3>
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <p class="pd-quote__by">
              <span class="pd-quote__name">{t.name}</span>
              <span class="pd-label">Coached by {t.coach}</span>
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pd-section" aria-labelledby="pd-why-title">
    <div class="pd-wrap">
      <header class="pd-head">
        <p class="pd-label pd-label--accent">Why Trilogy</p>
        <h2 class="pd-h2" id="pd-why-title">Built around <em>your life.</em></h2>
      </header>
      <PointList items={reasons} />
    </div>
  </section>

  <Cta />
</Layout>
