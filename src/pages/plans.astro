---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQ from '../components/FAQ.astro';
import { premade, trainingPeaksUrl } from '../data/site';
import './Plans.css';
---
<Layout
  title="Plans & Pricing | Trilogy Training | Find Your Perfect Coaching Plan"
  description="Single-discipline, multi-discipline, or custom coaching plans. Personalised triathlon, running, swimming, and cycling training tailored to your goals."
  canonicalPath="/plans/"
  ogTitle="Plans & Pricing | Trilogy Training"
  ogDescription="Single-discipline, multi-discipline, or custom coaching plans. Personalised training tailored to your goals."
>
  <Section background="default" class="section--plans-pricing">
    <div class="plans-hero">
      <p class="plans-hero__label">Coaching Plans</p>
      <h1 class="plans-hero__title">Plans &amp; Pricing</h1>
      <p class="plans-hero__subtitle">
        Personalised coaching with simple pricing.
      </p>
    </div>

    <PricingSection />
  </Section>

  <Section background="surface" divider="angle-top">
    <div class="premade">
      <p class="premade__label">{premade.label}</p>
      <h2 class="premade__title">{premade.title}</h2>
      <p class="premade__desc">{premade.desc}</p>
      <Button
        href={trainingPeaksUrl}
        variant="outline"
        size="lg"
        external
      >
        {premade.cta}
      </Button>
    </div>
  </Section>

  <Section background="alt" divider="angle-top" id="faq">
    <FAQ />
  </Section>
</Layout>
