---
/** Section header: mono index and label on the left, heading on the right. */
interface Props {
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---
<header class="rd-sec-head">
  <p class="rd-label"><span class="rd-label__idx">{index}</span>{label}</p>
  <h2 class="rd-h2">{title}</h2>
</header>
