---
/** Opening block of an inner page: a small label row, then the statement headline. */
interface Props {
  label: string;
  note?: string;
}

const { label, note } = Astro.props;
---
<div class="sw-pagehead">
  <div class="sw-wrap">
    <div class="sw-pagehead__meta">
      <p class="sw-label">{label}</p>
      {note && <p class="sw-label sw-label--grey">{note}</p>}
    </div>
    <h1 class="sw-display sw-pagehead__title"><slot /></h1>
  </div>
</div>
