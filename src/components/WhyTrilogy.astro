---
import Section from './Section.astro';
import './WhyTrilogy.css';
import { reasons } from '../data/site';
---
<Section background="alt" divider="angle-top" id="why-trilogy">
  <div class="why">
    <p class="why__label">The Difference</p>
    <h2 class="why__title">Why Trilogy Training</h2>

    <div class="why__grid">
      {reasons.map((r) => (
        <div class="why__card">
          <div class="why__icon-wrap">
            <span class="why__icon">{r.icon}</span>
          </div>
          <h3 class="why__card-title">{r.title}</h3>
          <p class="why__card-desc">{r.desc}</p>
        </div>
      ))}
    </div>
  </div>
</Section>
